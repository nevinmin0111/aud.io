<Window x:Class="SoundDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aud.io" Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#10131A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#191E29"/>
        <SolidColorBrush x:Key="CardBrush" Color="#222938"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#96A0B5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#45E0B7"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#323B50"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="#10131A"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="22,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="aud.io" FontWeight="Bold" FontSize="29"/>
                    <TextBlock Text="Every device. Every app. One mixer." Foreground="{DynamicResource SubtleBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DESIGN" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ThemePicker" Width="155" SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="Minimal" IsSelected="True"/>
                        <ComboBoxItem Content="DJ Neon"/>
                        <ComboBoxItem Content="Compact"/>
                    </ComboBox>
                    <Button Content="↻ Refresh" Click="Refresh_Click" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <DockPanel Margin="8,6">
                    <TextBlock Text="OUTPUT DEVICES" FontWeight="SemiBold" FontSize="18"/>
                    <TextBlock x:Name="DeviceCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="285">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,66,0"/>
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,2"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="DEFAULT" Foreground="#10131A" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,3,0,10"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DockPanel>
                                        <CheckBox Content="Mute" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IsMuted, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <Button Content="Use this output" HorizontalAlignment="Right" Tag="{Binding}" Click="MakeDefault_Click"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="8,22,8,6">
                    <TextBlock Text="APP MIXER" FontWeight="SemiBold" FontSize="18"/>
                    <TextBlock x:Name="SessionCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom"/>
                </DockPanel>

                <TextBlock x:Name="NoAppsMessage" Text="No app is playing sound yet. Start some music and it will appear automatically."
                           Foreground="{DynamicResource SubtleBrush}" Margin="12,16"/>

                <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="285" MinHeight="150">
                                <StackPanel>
                                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,12"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <CheckBox Content="Mute" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="18,9">
            <TextBlock Text="Closing this window keeps aud.io running beside the clock. Right-click its icon to exit."
                       Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
